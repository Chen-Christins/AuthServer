<table name="oauth_clients" namespace="auth.data" desc="OAuth 客户端注册表">
    <columns>
        <column name="id" type="int64" auto_increment="true" desc="主键"/>
        <column name="client_id" type="string" desc="客户端 ID"/>
        <column name="client_secret_hash" type="string" desc="client_secret 的 bcrypt 哈希"/>
        <column name="client_name" type="string" desc="客户端名称"/>
        <column name="redirect_uris" type="text" desc="回调 URI 白名单（JSON 数组）"/>
        <column name="grant_types" type="string" desc="允许的 grant_type"/>
        <column name="allowed_scopes" type="string" desc="允许的 scope 列表"/>
        <column name="client_uri" type="string" desc="客户端主页"/>
        <column name="logo_uri" type="string" desc="客户端图标"/>
        <column name="enabled" type="int32" default="1" desc="是否启用"/>
        <column name="create_time" type="datetime" default="current_timestamp" desc="创建时间"/>
        <column name="update_time" type="datetime" default="current_timestamp" desc="更新时间"/>
    </columns>
    <indexs>
        <index name="pk" cols="id" type="pk"/>
        <index name="idx_client_id" cols="client_id" type="uniq"/>
    </indexs>
</table>
